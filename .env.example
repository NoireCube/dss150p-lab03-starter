# Copy this file to .env and replace the training password before running anything.
# For host-side commands (venv), POSTGRES_HOST=localhost.
# Docker Compose overrides POSTGRES_HOST to the service name "postgres" for
# the pipeline/airflow containers -- do not change that override.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p
POSTGRES_PASSWORD=change_me

# Airflow container file ownership (Linux hosts only; harmless elsewhere)
AIRFLOW_UID=50000
